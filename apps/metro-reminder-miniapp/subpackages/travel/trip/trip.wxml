<view class="page">
  <view class="status">
    <view class="label">{{labels.currentStation}}</view>
    <view class="station">{{currentStationName}}</view>
    <view class="next">{{nextStationText}}</view>
  </view>

  <view class="target">{{targetText}}</view>
  <view class="warning" wx:if="{{warningText}}">{{warningText}}</view>

  <view class="actions">
    <button bindtap="handlePrevious">{{labels.previousStation}}</button>
    <button bindtap="handleNext">{{labels.nextStationButton}}</button>
  </view>

  <button class="secondary" bindtap="handleEndTrip">{{labels.endTrip}}</button>

  <reminder-modal visible="{{reminderVisible}}" title="{{reminderTitle}}" body="{{reminderBody}}" bind:confirm="handleReminderConfirm" />
</view>
