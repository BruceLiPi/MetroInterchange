.page {
  padding: 18px;
}

.input,
.field,
.note {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 12px;
  padding: 14px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label {
  color: #6b7280;
}

.note {
  min-height: 88px;
}

.options {
  margin: 4px 0 14px;
}

.section-title {
  margin-bottom: 8px;
  color: #374151;
  font-size: 14px;
  font-weight: 700;
}

.empty,
.option {
  margin-bottom: 10px;
  padding: 12px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
}

.empty {
  color: #6b7280;
}

.option-active {
  border-color: #111827;
  box-shadow: 0 0 0 1px #111827 inset;
}

.option-title {
  color: #111827;
  font-size: 15px;
  font-weight: 700;
}

.option-body {
  margin-top: 6px;
  color: #4b5563;
  font-size: 12px;
  line-height: 1.5;
}

.primary {
  background: #111827;
  color: #ffffff;
}
