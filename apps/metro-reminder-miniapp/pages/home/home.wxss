.page {
  padding: 18px;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}

.title {
  font-size: 24px;
  font-weight: 800;
}

.settings {
  color: #2563eb;
  font-size: 14px;
}

.routes {
  display: grid;
  gap: 12px;
  margin-bottom: 18px;
}

.primary,
.secondary {
  width: 100%;
  margin-top: 10px;
}

.primary {
  background: #111827;
  color: #ffffff;
}

.coverage {
  margin-top: 18px;
  color: #6b7280;
  font-size: 12px;
}
